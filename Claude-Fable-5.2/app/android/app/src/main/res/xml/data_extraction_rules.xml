<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of this app leaves the device through Android's own backup or
     device transfer. The data are encrypted with a key that is bound to this
     device; a copy elsewhere would be useless and is therefore not made. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
